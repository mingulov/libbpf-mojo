#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
# libbpf-mojo single supported build path.
#
# Usage: tools/build [--check-toolchain] [--sanitize] [--help]
#
# Verifies the pinned toolchain and builds every registered compile target.
# When no compile targets are registered yet, exit 0 covers toolchain
# verification plus an explicit notice naming the missing targets.
# --sanitize builds into build-san/ with AddressSanitizer and UBSan
# using the pinned gcc (this Ubuntu release ships no clang-21
# compiler-rt); run it via LMB_BUILD_DIR=build-san tools/test native.
# Prints each underlying command before running it. Exit 0 only when every
# step passes; exit 1 on build failure; exit 2 on invalid usage.
# One action per invocation; extra arguments are rejected.

set -u

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LOCK="$ROOT/toolchain.lock.json"

usage() {
    sed -n '2,/^$/p' "$0" | sed 's/^# //; s/^#//'
}

log() {
    echo "+ $*" >&2
}

check_toolchain() {
    log "check toolchain versions from toolchain.lock.json"
    python3 - "$LOCK" <<'EOF'
import json, re, subprocess, sys

lock_path = sys.argv[1]
with open(lock_path, "r", encoding="utf-8") as handle:
    lock = json.load(handle)
want_lines = lock["expected_first_lines"]
floors = lock.get("minimum_versions", {})

checks = [
    ("pixi", ["pixi", "--version"]),
    ("mojo", ["pixi", "run", "--frozen", "mojo", "--version"]),
    ("clang", ["clang", "--version"]),
    ("bpftool", ["bpftool", "--version"]),
    ("cmake", ["cmake", "--version"]),
    ("ninja", ["ninja", "--version"]),
    ("make", ["make", "--version"]),
    ("gcc", ["gcc", "--version"]),
    ("pkg-config", ["pkg-config", "--version"]),
    ("zlib", ["pkg-config", "--modversion", "zlib"]),
    ("python", ["python3", "--version"]),
]

failed = 0
for name, cmd in checks:
    try:
        out = subprocess.run(cmd, stdout=subprocess.PIPE,
                             stderr=subprocess.STDOUT, text=True,
                             check=False)
    except FileNotFoundError:
        print("FAIL %s: command not found: %s" % (name, cmd[0]))
        failed += 1
        continue
    first = out.stdout.splitlines()[0] if out.stdout else ""
    if out.returncode != 0:
        print("FAIL %s: exit status %d" % (name, out.returncode))
        failed += 1
    elif name in floors:
        floor = tuple(int(p) for p in floors[name].split("."))
        match = re.search(r"(\d+(?:\.\d+)+)", first)
        if match is None:
            print("FAIL %s: want at least %s, got %r"
                  % (name, floors[name], first.strip()))
            failed += 1
            continue
        got = tuple(int(p) for p in match.group(1).split("."))
        width = max(len(floor), len(got))
        got = got + (0,) * (width - len(got))
        floor = floor + (0,) * (width - len(floor))
        if got < floor:
            print("FAIL %s: want at least %s, got %r"
                  % (name, floors[name], first.strip()))
            failed += 1
        else:
            print("ok %s: %s (>= %s)"
                  % (name, first.strip(), floors[name]))
    elif first.strip() != want_lines[name]:
        print("FAIL %s: want exactly %r, got %r"
              % (name, want_lines[name], first.strip()))
        failed += 1
    else:
        print("ok %s: %s" % (name, first.strip()))
sys.exit(1 if failed else 0)
EOF
}

check_pixi_lock() {
    log pixi install --frozen
    (cd "$ROOT" && pixi install --frozen)
}

main() {
    if [ $# -eq 0 ]; then
        set -- ""
    fi
    if [ $# -gt 1 ]; then
        echo "build: too many arguments" >&2
        usage >&2
        return 2
    fi
    case "$1" in
        --help|-h)
            usage
            ;;
        --check-toolchain)
            cd "$ROOT" || return 1
            check_pixi_lock && check_toolchain || return 1
            ;;
        ""|--sanitize)
            cd "$ROOT" || return 1
            check_pixi_lock && check_toolchain || return 1
            BUILD_DIR=build
            SANITIZE_FLAG="-DLMB_SANITIZE=OFF"
            CC_NAME=clang
            if [ "$1" = "--sanitize" ]; then
                BUILD_DIR=build-san
                SANITIZE_FLAG="-DLMB_SANITIZE=ON"
                CC_NAME=gcc
            fi
            mkdir -p "$BUILD_DIR" || return 1
            log python3 tools/provenance.py seal "$ROOT"
            python3 tools/provenance.py seal "$ROOT" \
                >"$BUILD_DIR/sources-pre.json" || return 1
            if [ -f "$ROOT/native/CMakeLists.txt" ]; then
                log cmake -S native -B "$BUILD_DIR" -G Ninja \
                    -DCMAKE_C_COMPILER="$CC_NAME" "$SANITIZE_FLAG"
                cmake -S native -B "$BUILD_DIR" -G Ninja \
                    -DCMAKE_C_COMPILER="$CC_NAME" "$SANITIZE_FLAG" \
                    || return 1
                log cmake --build "$BUILD_DIR"
                cmake --build "$BUILD_DIR" || return 1
            else
                echo "build: no native targets registered yet" >&2
            fi
            # Declared CPU baseline for shipped artifacts: the
            # compiler otherwise tunes for the build host.
            if [ -f "$ROOT/examples/tracepoint/main.mojo" ]; then
                log pixi run --frozen mojo build -I src \
                    --target-cpu x86-64-v2 \
                    -o "$BUILD_DIR/examples/tracepoint_main" \
                    examples/tracepoint/main.mojo
                mkdir -p "$BUILD_DIR/examples"
                pixi run --frozen mojo build -I src \
                    --target-cpu x86-64-v2 \
                    -o "$BUILD_DIR/examples/tracepoint_main" \
                    examples/tracepoint/main.mojo || return 1
                log pixi run --frozen mojo build -I src \
                    --target-cpu x86-64-v2 \
                    -o "$BUILD_DIR/examples/fault_driver" \
                    tests/live/fault_driver.mojo
                pixi run --frozen mojo build -I src \
                    --target-cpu x86-64-v2 \
                    -o "$BUILD_DIR/examples/fault_driver" \
                    tests/live/fault_driver.mojo || return 1
            else
                echo "build: no Mojo targets registered yet" >&2
            fi
            log python3 tools/build_receipt.py "$BUILD_DIR" \
                "$CC_NAME" "$SANITIZE_FLAG"
            python3 tools/build_receipt.py "$BUILD_DIR" \
                "$CC_NAME" "$SANITIZE_FLAG" || return 1
            ;;
        *)
            echo "build: unknown argument: $1" >&2
            usage >&2
            return 2
            ;;
    esac
}

main "$@"
