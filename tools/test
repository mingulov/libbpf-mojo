#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
# libbpf-mojo test runner.
#
# Usage: tools/test <suite> [--host-only] | tools/test --help
# --host-only excludes live kernel cases before any privilege probe;
# native host test executables preload the permanent no-BPF guard.
# Omitted cases are NOT_RUN and cannot qualify kernel behavior.
# source-export also accepts --host-only. LMB_LIBBPF_SOURCE_ARCHIVE
# optionally supplies its hash-checked local libbpf source archive.
#
# Implemented suites: native, mojo, live-tracepoint, cleanup, package,
# package-consumer, source-export, contracts, runner, selftest, provenance.
# contracts requires explicit offline LMB_TEST_CONTRACT_BUNDLE data.
# LMB_PACKAGE_CONSUMER_OUT optionally retains installed-consumer attempts.
# The runner suite
# drives the packaged demo
# runner against fake doubles; selftest runs the unprivileged
# stdlib-only Python probes. Neither needs privilege or docker.
# LMB_BUILD_DIR selects the CMake build tree (default: build); use
# LMB_BUILD_DIR=build-san with a tools/build --sanitize tree for the
# AddressSanitizer/UBSan run.
# PIXI_BIN selects the pixi executable for the mojo suite (default:
# pixi on PATH). When pixi is unavailable, the suite falls back to the
# installed pixi environment directly and says so.
#
# A skipped selected test fails the suite, never success: the default
# native scope requires its live selection, while the host-only scope
# declares live cases NOT_RUN before selection. Exit 0 only when every
# selected test passes; 77 when a privileged suite skips for lack of
# privilege; 1 on test failure or an incomplete selection; 2 on usage
# error. One suite per invocation; extra arguments are rejected.

set -u

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BUILD_DIR="${LMB_BUILD_DIR:-build}"

usage() {
    sed -n '2,/^$/p' "$0" | sed 's/^# //; s/^#//'
}

run_native() {
    if [ ! -f "$ROOT/$BUILD_DIR/CTestTestfile.cmake" ]; then
        echo "test: no native suite in $BUILD_DIR;" \
            "run tools/build first" >&2
        exit 2
    fi
    echo "+ ctest in $BUILD_DIR" >&2
    log="$(mktemp)"
    trap 'rm -f "$log"' EXIT
    if [ "${LMB_HOST_ONLY:-0}" = 1 ]; then
        guard="$ROOT/$BUILD_DIR/liblmb_host_guard.so"
        if [ ! -f "$guard" ]; then
            echo "test: missing host guard $guard; run tools/build first" >&2
            exit 2
        fi
        echo "test: host-only scope; kernel qualification remains NOT_RUN" >&2
        echo "NOT_RUN native: poll_semantics attach_rollback map_access ring_framing.load-dual generic_abi_probe.PartB generic_maps.kernel-load-and-operations generic_testrun.kernel-runtime generic_attach.kernel-runtime generic_ring.kernel-production-and-events" >&2
        # Each twin launches a guarded native leaf. CTest and shell
        # orchestration do not inherit the syscall interposer. Select
        # each host check once, with the four read-only export checks.
        (cd "$ROOT/$BUILD_DIR" && ctest --output-on-failure \
            -R '^(native_host_.*|exports|testfake_exports|generic_testfake_exports|generic_objectonly_exports|events_.*_exports)$') >"$log" 2>&1
        rc=$?
    else
        (cd "$ROOT/$BUILD_DIR" && ctest --output-on-failure -E '^native_host_') >"$log" 2>&1
        rc=$?
    fi
    cat "$log"
    # CTest aggregates skipped tests to status 0. A skip inside the
    # selected set is an incomplete qualification, never a pass.
    skipped="$(sed -n 's/.*Test  *#[0-9][0-9]*: \([^ ][^ ]*\) .*[*][*][*]\(Skipped\|Not Run\|Timeout\|Exception\).*/\1/p' "$log" | sort -u | tr '\n' ' ')"
    skipped="${skipped% }"
    rm -f "$log"
    trap - EXIT
    if [ -n "$skipped" ]; then
        if [ "${LMB_HOST_ONLY:-0}" = 1 ]; then
            echo "test: host-only selection incomplete, skipped or not run: $skipped" >&2
            echo "test: a skip among selected host tests means broken provisioning" >&2
        else
            echo "test: default native selection incomplete, skipped or not run: $skipped" >&2
            echo "test: live kernel cases are required here; use 'tools/test native --host-only' for the declared offline scope" >&2
        fi
        # A genuine CTest failure keeps its exit code; only a zero
        # aggregate with missing selections synthesizes exit 1.
        if [ "$rc" -ne 0 ]; then
            exit "$rc"
        fi
        exit 1
    fi
    exit "$rc"
}

# Sets the MOJO array to the pinned-compiler invocation. Builds the
# argument vector directly so paths with spaces survive.
mojo_setup() {
    if [ -n "${PIXI_BIN:-}" ]; then
        MOJO=("$PIXI_BIN" run --frozen mojo)
    elif command -v pixi >/dev/null 2>&1; then
        MOJO=(pixi run --frozen mojo)
    elif [ -x "$ROOT/.pixi/envs/default/bin/mojo" ]; then
        echo "test: pixi not on PATH; using $ROOT/.pixi directly" >&2
        MOJO=("$ROOT/.pixi/envs/default/bin/mojo")
    else
        echo "test: no pixi and no installed pixi environment;" \
            "run pixi install first" >&2
        exit 2
    fi
}

# Checks one compile_fail fixture: $1 is the fixture path, $2 a scratch
# directory. Uses $ROOT and the $MOJO array from mojo_setup. Only primary
# messages in complete supported renderer blocks can satisfy CHECK; source
# excerpts, notes, context, trailers and the fixture's own path cannot.
# MUST-REJECT requires genuine primary evidence with no matching message.
# Unknown or incomplete rendering refuses either kind of fixture.
check_compile_fail() {
    f=$1
    tmpdir=$2
    want="$(grep -m1 '# CHECK: ' "$f" | sed 's/.*# CHECK: //')"
    if [ -z "$want" ]; then
        echo "test: no CHECK line in $f" >&2
        return 1
    fi
    must_reject=0
    if grep -q '# MUST-REJECT' "$f"; then
        must_reject=1
    fi
    echo "+ mojo build (must fail) $f" >&2
    if out="$(cd "$ROOT" && "${MOJO[@]}" build --num-threads 2 --target-cpu x86-64-v2 -I src \
            -I tests/mojo "$f" -o "$tmpdir/probe" 2>&1)"; then
        echo "test: compile-fail fixture compiled: $f" >&2
        return 1
    fi
    if ! printf '%s\n' "$out" | python3 "$ROOT/tools/compile_fail_diagnostics.py" \
            "$f" "$want" "$must_reject"; then
        echo "test: wrong or unusable rejection for $f (CHECK: $want; MUST-REJECT: $must_reject)" >&2
        printf '%s\n' "$out" | head -5 >&2
        return 1
    fi
}

run_mojo() {
    if [ "${LMB_HOST_ONLY:-0}" = 1 ]; then
        echo "test: host-only scope; kernel qualification remains NOT_RUN" >&2
        echo "NOT_RUN mojo: test_load_valid_branches_privilege generic_maps.kernel-runtime generic_testrun.kernel-runtime" >&2
    fi
    native_lib="$ROOT/$BUILD_DIR/libbpf_mojo.so.1"
    fake_lib="$ROOT/$BUILD_DIR/liblmb_testfake.so"
    stub_lib="$ROOT/$BUILD_DIR/liblmb_stub.so"
    generic_fake="$ROOT/$BUILD_DIR/liblmb_generic_testfake.so"
    generic_older="$ROOT/$BUILD_DIR/liblmb_generic_objectonly.so"
    host_guard="$ROOT/$BUILD_DIR/liblmb_host_guard.so"
    fixture="$ROOT/$BUILD_DIR/fixtures/ring_test.bpf.o"
    for need in "$native_lib" "$fake_lib" "$stub_lib" "$fixture" "$generic_fake" "$generic_older" "$host_guard"; do
        if [ ! -f "$need" ]; then
            echo "test: missing $need; run tools/build first" >&2
            exit 2
        fi
    done
    mojo_setup
    export LMB_NATIVE_LIB="$native_lib"
    export LMB_TESTFAKE_LIB="$fake_lib"
    export LMB_STUB_LIB="$stub_lib"
    export LMB_FIXTURE="$fixture"
    export LMB_GENERIC_FIXTURE="$ROOT/$BUILD_DIR/fixtures/generic_object.bpf.o"
    export LMB_GENERIC_NOMAP_FIXTURE="$ROOT/$BUILD_DIR/fixtures/generic_nomap.bpf.o"
    export LMB_GENERIC_MAPS_FIXTURE="$ROOT/$BUILD_DIR/fixtures/generic_maps.bpf.o"
    export LMB_GENERIC_TESTFAKE_LIB="$generic_fake"
    export LMB_GENERIC_OBJECTONLY_LIB="$generic_older"
    export LMB_GENERIC_EVENTS_FIXTURE="$ROOT/$BUILD_DIR/fixtures/generic_events.bpf.o"
    for variant in testfake no_events no_attach no_link_close no_buffer_open no_buffer_poll no_buffer_close; do
        path="$ROOT/$BUILD_DIR/liblmb_events_$variant.so"
        if [ ! -f "$path" ]; then
            echo "test: missing $path; run tools/build first" >&2
            exit 2
        fi
        key="LMB_EVENTS_${variant^^}_LIB"
        printf -v "$key" '%s' "$path"
        export "$key"
    done
    tmpdir="$(mktemp -d)"
    trap 'rm -rf "$tmpdir"' EXIT
    failed=0
    count=0
    for t in "$ROOT"/tests/mojo/test_*.mojo; do
        count=$((count + 1))
        echo "+ mojo run $t" >&2
        mojo_case "$t" "$tmpdir/$(basename "$t" .mojo)" \
            || failed=1
        if [ "$(basename "$t")" = test_generic_buffer.mojo ] && [ "${LMB_HOST_ONLY:-0}" = 1 ]; then
            for negative in reset-live end-live begin-live; do
                output="$tmpdir/$negative.log"
                LD_PRELOAD="$host_guard" "$tmpdir/test_generic_buffer" "$negative" >"$output" 2>&1
                rc=$?
                if [ "$rc" -ne 99 ] || ! grep -qF 'refused with live' "$output"; then
                    echo "test: wrong live-consumer refusal for $negative (exit $rc)" >&2
                    cat "$output" >&2
                    failed=1
                fi
            done
        fi
    done
    if [ "$count" -eq 0 ]; then
        echo "test: no Mojo tests found" >&2
        exit 2
    fi
    for f in "$ROOT"/tests/mojo/compile_fail/*.mojo; do
        [ -e "$f" ] || continue
        check_compile_fail "$f" "$tmpdir" || failed=1
    done
    for f in "$ROOT"/tests/mojo/compile_pass/*.mojo; do
        [ -e "$f" ] || continue
        echo "+ mojo run (must pass) $f" >&2
        mojo_case "$f" "$tmpdir/$(basename "$f" .mojo)" \
            || failed=1
    done
    trap - EXIT
    rm -rf "$tmpdir"
    if [ "$failed" -ne 0 ]; then
        echo "test: mojo suite FAILED" >&2
        exit 1
    fi
    echo "test: mojo suite passed ($count files)" >&2
}

mojo_case() {
    if [ "${LMB_HOST_ONLY:-0}" = 1 ]; then
        # Compile without the interposer; guard only the native executable.
        (cd "$ROOT" && "${MOJO[@]}" build --num-threads 2 \
            --target-cpu x86-64-v2 -I src -I tests/mojo "$1" -o "$2") || return 1
        sha256sum "$2" || return 1
        (cd "$ROOT" && LD_PRELOAD="$host_guard" "$2")
    else
        (cd "$ROOT" && "${MOJO[@]}" run --num-threads 2 -I src -I tests/mojo "$1")
    fi
}

run_live() {
    script="$ROOT/tests/live/$1"
    if [ ! -f "$script" ]; then
        echo "test: no live suite $1" >&2
        exit 2
    fi
    echo "+ python3 tests/live/$1" >&2
    (cd "$ROOT" && python3 "$script")
    rc=$?
    if [ "$rc" -eq 77 ]; then
        echo "test: $1 skipped (no privilege or missing verifier)" >&2
        exit 77
    fi
    exit "$rc"
}

if [ $# -eq 0 ]; then
    usage >&2
    exit 2
fi
if [ $# -eq 2 ] && [ "$2" = --host-only ]; then
    case "$1" in
        native|mojo|source-export) ;;
        *) echo "test: --host-only applies only to native, mojo or source-export" >&2; exit 2 ;;
    esac
    export LMB_HOST_ONLY=1
    set -- "$1"
fi
if [ $# -gt 1 ]; then
    echo "test: too many arguments" >&2
    usage >&2
    exit 2
fi
case "$1" in
    --help|-h)
        usage
        ;;
    native)
        run_native
        ;;
    mojo)
        run_mojo
        ;;
    live-tracepoint)
        run_live test_tracepoint.py
        ;;
    cleanup)
        run_live test_cleanup.py
        ;;
    package)
        script="$ROOT/tests/package/test_package.py"
        echo "+ python3 tests/package/test_package.py" >&2
        (cd "$ROOT" && python3 "$script")
        rc=$?
        if [ "$rc" -eq 77 ]; then
            echo "test: package skipped (no docker)" >&2
            exit 77
        fi
        exit "$rc"
        ;;
    runner)
        echo "+ bash tests/runner/test_runner.sh" >&2
        (cd "$ROOT" && bash tests/runner/test_runner.sh)
        exit "$?"
        ;;
    provenance)
        echo "+ python3 tests/provenance/test_provenance.py" >&2
        (cd "$ROOT" && python3 tests/provenance/test_provenance.py)
        exit "$?"
        ;;
    source-export)
        source_args=()
        if [ "${LMB_HOST_ONLY:-0}" = 1 ]; then
            source_args+=(--host-only)
        fi
        if [ -n "${LMB_LIBBPF_SOURCE_ARCHIVE:-}" ]; then
            source_args+=(--cached-libbpf-archive "$LMB_LIBBPF_SOURCE_ARCHIVE")
        fi
        (cd "$ROOT" && python3 tests/package/test_source_export.py "${source_args[@]}")
        exit "$?"
        ;;
    package-consumer)
        echo "+ python3 tests/package/test_consumer_lane.py" >&2
        (cd "$ROOT" && python3 tests/package/test_consumer_lane.py)
        rc=$?
        if [ "$rc" -eq 77 ]; then
            echo "test: package-consumer skipped" >&2
            exit 77
        fi
        exit "$rc"
        ;;
    contracts)
        if [ -z "${LMB_TEST_CONTRACT_BUNDLE:-}" ]; then
            echo "NOT_RUN contracts: set LMB_TEST_CONTRACT_BUNDLE to explicit offline data" >&2
            exit 1
        fi
        (cd "$ROOT" && python3 tests/contracts/test_schema_bundle.py)
        exit "$?"
        ;;
    selftest)
        echo "+ python3 tests/selftest" >&2
        fails=0
        for t in "$ROOT"/tests/selftest/test_*.py; do
            echo "+ python3 ${t#$ROOT/}" >&2
            (cd "$ROOT" && python3 "$t") || fails=1
        done
        if [ "$fails" -ne 0 ]; then
            echo "test: selftest suite FAILED" >&2
            exit 1
        fi
        echo "test: selftest suite passed" >&2
        ;;
    *)
        echo "test: unknown suite: $1" >&2
        usage >&2
        exit 2
        ;;
esac
